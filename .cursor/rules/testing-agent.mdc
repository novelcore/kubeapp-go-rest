## Test Generation Patterns

### FastAPI Router Testing
```python
import pytest
from fastapi.testclient import TestClient
from app.main import app

client = TestClient(app)

class TestUserRouter:
    """Test suite for user management endpoints"""
    
    def test_create_user_success(self):
        """Test successful user creation"""
        user_data = {
            "name": "John Doe",
            "email": "john@example.com"
        }
        response = client.post("/users", json=user_data)
        assert response.status_code == 201
        assert response.json()["name"] == "John Doe"
    
    def test_create_user_validation_error(self):
        """Test user creation with invalid data"""
        invalid_data = {
            "name": "",  # Invalid: empty name
            "email": "invalid-email"  # Invalid: malformed email
        }
        response = client.post("/users", json=invalid_data)
        assert response.status_code == 422
    
    def test_get_user_success(self):
        """Test successful user retrieval"""
        response = client.get("/users/1")
        assert response.status_code == 200
        assert "id" in response.json()
    
    def test_get_user_not_found(self):
        """Test user retrieval with non-existent ID"""
        response = client.get("/users/999")
        assert response.status_code == 404
```

### Pydantic Model Testing
```python
import pytest
from pydantic import ValidationError
from app.core.fastapi.models.user_models import UserRequest, UserResponse

class TestUserModels:
    """Test suite for user Pydantic models"""
    
    def test_user_request_valid(self):
        """Test valid user request model"""
        user_data = {
            "name": "John Doe",
            "email": "john@example.com"
        }
        user_request = UserRequest(**user_data)
        assert user_request.name == "John Doe"
        assert user_request.email == "john@example.com"
    
    def test_user_request_validation_error(self):
        """Test user request validation errors"""
        invalid_data = {
            "name": "",  # Too short
            "email": "invalid"  # Invalid format
        }
        with pytest.raises(ValidationError):
            UserRequest(**invalid_data)
    
    def test_user_response_serialization(self):
        """Test user response serialization"""
        user_data = {
            "id": 1,
            "name": "John Doe",
            "email": "john@example.com"
        }
        user_response = UserResponse(**user_data)
        assert user_response.dict() == user_data
```

### Service Layer Testing
```python
import pytest
from unittest.mock import Mock, patch
from app.core.services.user_service import UserService

class TestUserService:
    """Test suite for user service layer"""
    
    def setup_method(self):
        """Set up test fixtures"""
        self.user_service = UserService()
    
    def test_create_user_success(self):
        """Test successful user creation"""
        user_data = {
            "name": "John Doe",
            "email": "john@example.com"
        }
        result = self.user_service.create_user(user_data)
        assert result["name"] == "John Doe"
        assert "id" in result
    
    @patch('app.core.services.user_service.database')
    def test_create_user_database_error(self, mock_db):
        """Test user creation with database error"""
        mock_db.save.side_effect = Exception("Database error")
        user_data = {
            "name": "John Doe",
            "email": "john@example.com"
        }
        with pytest.raises(Exception):
            self.user_service.create_user(user_data)
```

