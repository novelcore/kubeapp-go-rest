# Feature flags
ZITADEL_OIDC=false       # Set true to enable Zitadel JWT authentication
OBSERVABILITY=false      # Set true to enable Prometheus metrics + OpenTelemetry

# Server
SERVER_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text          # text for dev, json for prod

# Zitadel OIDC (only required when ZITADEL_OIDC=true)
ZITADEL_DOMAIN=zitadel.example.com
JWT_ISSUER=https://zitadel.example.com
JWT_AUDIENCE=<project_id>
JWT_JWKS_URL=https://zitadel.example.com/oauth/v2/keys

# Observability (only required when OBSERVABILITY=true)
OTLP_GRPC_ENDPOINT=http://tempo:4317
